# Compose env file — every app service loads this via `env_file: .env`.
# Hostnames are the compose service names on the defense_net network.

# Database
DATABASE_URL=postgresql://defense:defense@postgres:5432/defense

# Redis
REDIS_URL=redis://redis:6379/0

# ClickHouse — the assembler uses the native-protocol driver (port 9000),
# parsed from this DSN, so keep the clickhouse:// scheme (not http://:8123).
CLICKHOUSE_URL=clickhouse://defense:defense@clickhouse:9000/defense

# MinIO (boto3 endpoint_url requires the scheme)
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=defense

# ---------------------------------------------------------------------------
# LLM backend (matches the repo-root .env.example)
# ---------------------------------------------------------------------------
# "groq" (cloud) or "local" (Ollama / any OpenAI-compatible endpoint)
LLM_BACKEND=local

# Groq — only used when LLM_BACKEND=groq
GROQ_API_KEY=your_groq_api_key_here

# Local backend — Ollama running on the HOST. Containers reach the host's
# Ollama via host.docker.internal (the stage2/agents services map it with
# extra_hosts: host-gateway for Linux).
LOCAL_LLM_BASE_URL=http://host.docker.internal:11434/v1
LOCAL_LLM_API_KEY=ollama

# Model selection — local names must match `ollama list` (tag included).
LLM_A_LOCAL_MODEL=qwen2.5:7b
LLM_A_GROQ_MODEL=llama-3.1-8b-instant
LLM_B_LOCAL_MODEL=qwen2.5:7b
LLM_B_GROQ_MODEL=llama-3.3-70b-versatile
VLM_LOCAL_MODEL=qwen3-vl:4b
VLM_GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Stage-1 NLP — the default stage1 image only ships the stub deps, keep true.
MODEL_STUB_MODE=true

# Auth
JWT_SECRET=change-me-in-production
API_KEY_HEADER=X-API-Key

# Logging
LOG_LEVEL=INFO

# Upstream API
UPSTREAM_API_URL=http://upstream-api/v1
UPSTREAM_API_KEY=upstream_key_here
