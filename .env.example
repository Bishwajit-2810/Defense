# Database
DATABASE_URL=postgresql://defense:defense@postgres:5432/defense

# Redis
REDIS_URL=redis://redis:6379/0

# Vector search uses pgvector inside Postgres (analysis_results.embedding) —
# no separate vector-store URL needed; it shares DATABASE_URL above.

# ClickHouse
CLICKHOUSE_URL=http://defense:defense@clickhouse:8123/defense

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=defense

# LLM backend selection: "groq" or "local"
LLM_BACKEND=local

# Groq
GROQ_API_KEY=your_groq_api_key_here

# Local backend — Ollama's OpenAI-compatible endpoint (no GPU/vLLM needed).
#   ollama serve   # exposes http://localhost:11434
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_API_KEY=ollama

# Model selection — local names must match `ollama list` (tag included).
# Stage 1 (Fast NLP) and Stage 2 use DIFFERENT models: stage1 = fast/light
# (gemma3:4b), stage2 = quality (qwen2.5:7b).
STAGE1_LOCAL_MODEL=gemma3:4b
STAGE1_GROQ_MODEL=llama-3.1-8b-instant
STAGE2_LOCAL_MODEL=qwen2.5:7b
STAGE2_GROQ_MODEL=llama-3.3-70b-versatile
# llm_a / llm_b — agents + report layer (fast / quality roles).
LLM_A_LOCAL_MODEL=qwen2.5:7b
LLM_A_GROQ_MODEL=llama-3.1-8b-instant
LLM_B_LOCAL_MODEL=qwen2.5:7b
LLM_B_GROQ_MODEL=llama-3.3-70b-versatile
VLM_LOCAL_MODEL=qwen3-vl:4b
VLM_GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# STAGE1_LLM=true → Stage-1 Fast-NLP workers compute their NLP via the stage1
# LLM (embeddings still come from the SentenceTransformer / stub). Falls back to
# the deterministic stub on any LLM failure.
STAGE1_LLM=true
STAGE1_LLM_COMMENT_MAX=60

# Auth
JWT_SECRET=change-me-in-production
API_KEY_HEADER=X-API-Key

# Logging
LOG_LEVEL=INFO

# Upstream API
UPSTREAM_API_URL=http://upstream-api/v1
UPSTREAM_API_KEY=upstream_key_here
