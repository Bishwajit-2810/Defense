# =============================================================================
# DEFENSE ENVIRONMENT CONFIGURATION
# Copy to .env and fill in the secrets. Hostnames below assume deploy/docker-compose.yml;
# swap them for localhost when running the services directly.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. CORE INFRASTRUCTURE (Database, Queue & Object Store)
# -----------------------------------------------------------------------------
# Vector search uses pgvector inside Postgres — no separate vector-store URL.
DATABASE_URL=postgresql://defense:defense@postgres:5432/defense
REDIS_URL=redis://redis:6379/0
CLICKHOUSE_URL=http://defense:defense@clickhouse:8123/defense

# MinIO S3-compatible Object Storage
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=defense

# -----------------------------------------------------------------------------
# 2. LLM BACKEND & API KEYS
# -----------------------------------------------------------------------------
# "local" (Ollama / vLLM) or "groq" (Cloud API)
LLM_BACKEND=local

# Local backend — Ollama / vLLM OpenAI-compatible endpoint (`ollama serve`)
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_API_KEY=ollama

# Cloud backend — used when LLM_BACKEND=groq or on auto-failover
GROQ_API_KEY=your_groq_api_key_here

# -----------------------------------------------------------------------------
# 3. MODEL SELECTION & GROQ FALLBACKS
# -----------------------------------------------------------------------------
# Pipeline Models: Stage 1 (high-volume NLP) runs small; Stage 2 (classification) runs bigger
STAGE1_LOCAL_MODEL=gemma3:4b
STAGE1_GROQ_MODEL=llama-3.1-8b-instant

STAGE2_LOCAL_MODEL=qwen2.5:7b
STAGE2_GROQ_MODEL=llama-3.3-70b-versatile

SUMMARY_LOCAL_MODEL=qwen2.5:7b
SUMMARY_GROQ_MODEL=llama-3.3-70b-versatile

# Dedicated 3rd Model for Agentic RAG & Multi-Turn Tool Use (native function calling)
AGENT_LOCAL_MODEL=llama3.1:8b
AGENT_GROQ_MODEL=llama-3.3-70b-versatile

# Role-based fallbacks (llm_a = fast, llm_b = deep reasoning)
LLM_A_LOCAL_MODEL=qwen2.5:7b
LLM_A_GROQ_MODEL=llama-3.1-8b-instant
LLM_B_LOCAL_MODEL=qwen2.5:7b
LLM_B_GROQ_MODEL=llama-3.3-70b-versatile

# Vision-language model for image posts
VLM_LOCAL_MODEL=qwen3-vl:4b
VLM_GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# -----------------------------------------------------------------------------
# 4. RAG & VECTOR SEARCH (pgvector)
# -----------------------------------------------------------------------------
# Multilingual 768-dim SentenceTransformer (Bangla, English, Banglish)
EMBEDDING_DIM=768
EMBEDDING_MODEL=paraphrase-multilingual-mpnet-base-v2
# true = no heavy ML weights are downloaded or loaded
MODEL_STUB_MODE=true

# -----------------------------------------------------------------------------
# 5. PIPELINE EXECUTION & COVERAGE
# -----------------------------------------------------------------------------
STAGE1_LLM=true
STAGE1_LLM_COMMENTS=false

# 0 = full coverage; positive integer = max comments per post
STAGE1_LLM_COMMENT_MAX=0
COMMENT_STANCE_MAX_PER_POST=0

STAGE1_LLM_BATCH=25
STAGE1_LLM_CONCURRENCY=3
COMMENT_STANCE_BATCH=25
COMMENT_STANCE_CONCURRENCY=3

SUMMARY_MAX_TOKENS=1024
COMMENT_SUMMARY_MAX_TOKENS=640
INSIGHT_MAX_TOKENS=768
LLM_MAX_CONTINUATIONS=2

COMMENT_LAUGH_SENTIMENT=negative
STAGE1_OCR_SENTIMENT=false

# -----------------------------------------------------------------------------
# 6. AUTHENTICATION & SECURITY
# -----------------------------------------------------------------------------
APP_ENV=dev
JWT_SECRET=change-me-in-production
API_KEY_HEADER=X-API-Key
JWT_EXPIRE_HOURS=12
ALLOW_ANY_LOGIN=true
ALLOW_SIGNUP=true
SIGNUP_TENANT_ID=default

# -----------------------------------------------------------------------------
# 7. SERVICES, MCP PORTS & LOGGING
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
PUBLIC_BASE_URL=http://localhost:8001
AGENTS_SERVICE_URL=http://localhost:8001
ANALYTICS_MCP_PORT=8100
RETRIEVAL_MCP_PORT=8101
INGEST_MCP_PORT=8102

ANALYTICS_MCP_STUB=false
RETRIEVAL_MCP_STUB=false

# -----------------------------------------------------------------------------
# 8. UPSTREAM SCRAPER INTEGRATION
# -----------------------------------------------------------------------------
UPSTREAM_API_URL=http://upstream-api/v1
UPSTREAM_API_KEY=upstream_key_here
